# ─── Stripe ──────────────────────────────────────────────────────────────────
#
# Clave secreta de la API de Stripe.
# Obtener en: https://dashboard.stripe.com/apikeys
# Usar clave de TEST (sk_test_...) en desarrollo, LIVE (sk_live_...) en producción.
STRIPE_SECRET_KEY=sk_test_reemplaza_con_tu_clave_secreta

# Secreto para verificar la firma de los webhooks entrantes de Stripe.
# Obtener en: https://dashboard.stripe.com/webhooks → seleccionar endpoint → "Signing secret"
# Cada endpoint tiene su propio secreto. El de CLI local es diferente al de producción.
STRIPE_WEBHOOK_SECRET=whsec_reemplaza_con_tu_webhook_secret

# Versión de la API de Stripe que usa este proyecto.
# Cambiar sólo si Stripe depreca la versión actual y el proyecto migra.
# Versiones disponibles: https://stripe.com/docs/upgrades#api-versions
STRIPE_API_VERSION=2024-06-20
