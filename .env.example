# ─── LLM ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4096

# ─── Proyecto ────────────────────────────────────────────────────────
# Nombre del namespace activo (puedes sobreescribir con --namespace)
ACTIVE_NAMESPACE=

# Alerta si el costo del dia supera este valor en USD
COST_ALERT_USD=2.00

# Nivel de log: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# ─── Shell MCP ───────────────────────────────────────────────────────
SHELL_ALLOWED_COMMANDS=npm,npx,yarn,pnpm,python,pytest,pip,node,tsc,eslint,prettier,docker,docker-compose,make,cat,ls,find,grep
SHELL_TIMEOUT=30

# ─── Browser MCP (opcional) ──────────────────────────────────────────
BROWSER_HEADLESS=true
BROWSER_BASE_URL=http://localhost:3300
